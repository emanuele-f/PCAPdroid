    <string name="app_intro_geolocation_msg">PCAPdroid יכולה לשאול מסד נתונים מקומי כדי לקבוע את המדינה של שרת מרוחק\n\nתחילה עליך להוריד את מסד נתוני המיקום מהגדרות האפליקציה</string>
    <string name="vpn_setup_msg">PCAPdroid מדמה VPN כדי ללכוד את תעבורת הרשת ללא root.\n\nכדי להתחיל את הלכידה, עליך לאשר את בקשת ה-VPN במסך הבא.\n\n<b>שימו לב:</b> כדי להמשיך, יש להשבית כל VPN תמידי מוגדר בהגדרות Android</string>
    <string name="app_intro_traffic_inspection">בדיקת בקשות ותגובות HTTP ונתונים גולמיים היא קלה הודות למפענחים המובנים\n\nיש לך חיבור מוצפן? ניתן להפעיל את <a href='%1$s'>פענוח ה-TLS</a> כדי לקבל את הנתונים המפוענחים</string>
    <string name="app_intro_firewall_msg">עם <a href='%1$s'>חומת האש</a> המובנית ניתן לחסום בקלות גישה לאינטרנט לאפליקציות, לדומיינים ולמדינות בודדות\n\nשלב זאת עם הנראות המובנית של התעבורה כדי לקבל את הכלי האולטימטיבי להגנת הפרטיות</string>
    <string name="app_intro_malware_detection">שפר את אבטחת המכשיר עם תכונת <a href='%1$s'>זיהוי התוכנות הזדוניות</a>\n\nבאמצעות רשימות חסימה מעודכנות, היא מזהה, חוסמת ומתריעה על חיבורים זדוניים בזמן אמת</string>
    <string name="app_intro_traffic_dump">PCAPdroid מציעה <a href='%1$s'>מספר דרכים</a> לשמור את התעבורה בפורמט PCAP הסטנדרטי לניתוח נוסף\n\nבאמצעות <a href='%2$s'>אפשרות ההרחבות של PCAPdroid</a> ניתן להוסיף שמות אפליקציות למנות ולהציג אותם ב-Wireshark</string>
