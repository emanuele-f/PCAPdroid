    <string name="app_intro_welcome_msg">PCAPdroid היא אפליקציה שומרת פרטיות שמאפשרת לעקוב אחרי החיבורים שהאפליקציות במכשיר מבצעות ולנתח אותם\n\nבנוסף, היא מאפשרת לייצא קובץ PCAP של התעבורה, לחלץ מטא-נתונים ועוד!</string>
    <string name="privacy_first">הפרטיות תחילה</string>
    <string name="app_intro_privacy_msg">האפליקציה אינה משתמשת בשום תכונות מעקב, אנליטיקה או דיווח לשרת חיצוני\n\nאיך אפשר להיות בטוח? עיין ב<a href='%1$s'>מדיניות הפרטיות</a> וב<a href='%2$s'>קוד המקור</a> שלה</string>
